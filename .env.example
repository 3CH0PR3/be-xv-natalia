APP_NAME="XV Natalia Isabella"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="America/Caracas"
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xv_natalia
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Transmisión y Colas:
# En Local: QUEUE_CONNECTION=sync para que las reacciones transmitan de inmediato sin worker.
# En Producción: QUEUE_CONNECTION=redis (requiere ejecutar php artisan queue:work).
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=redis
CACHE_PREFIX=xv_natalia_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hola@xvnatalia.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Reverb (WebSockets en Tiempo Real)
REVERB_APP_ID=xv-natalia-reverb
REVERB_APP_KEY=xv_natalia_key_2026
REVERB_APP_SECRET=xv_natalia_secret_super_seguro
REVERB_HOST="127.0.0.1"
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8081

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

XV_HOST_PIN=1515
XV_MONITORING_PIN='$*Developer1'
XV_DEFAULT_EVENT_CODE=XV-NATALIA
XV_MEDIA_DISK=public
ALLOW_DESKTOP_CAPTURE=false

# Horizon
HORIZON_ENABLED=true
HORIZON_PREFIX=xv_natalia_horizon:

# Pulse
PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_SERVER_SAMPLE_RATE=0.25
PULSE_SLOW_REQUEST_THRESHOLD=1000
PULSE_SLOW_JOB_THRESHOLD=1000
PULSE_SLOW_QUERY_THRESHOLD=1000
